{
  "priority": 1,
  "request": {
    "method": "ANY",
    "urlPathPattern": "/.*",
    "queryParameters": {
      "forceError": { "equalTo": "true" }
    }
  },
  "response": {
    "status": 500,
    "bodyFileName": "error-500-body.json",
    "headers": {
      "Content-Type": "application/json"
    }
  }
}